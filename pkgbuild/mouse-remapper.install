_reload_uinput() {
    modprobe uinput 2>/dev/null || true
    udevadm control --reload 2>/dev/null || true
    udevadm trigger --sysname-match=uinput 2>/dev/null || true
}

post_install() {
    _reload_uinput
    cat <<'MSG'

==> Mouse Remapper installed.
==> To read the mouse, your user must be in the "input" group:
==>     sudo usermod -aG input $USER
==> Then RESTART the computer (closing and reopening the app is not enough).
==> Macros are saved in ~/.config/mouse-remapper/config.json and applied by the
==> user service "mouse-remapper.service" (enabled when you click Save).

==> Mouse Remapper instalado.
==> Para ler o mouse, seu usuário precisa estar no grupo "input":
==>     sudo usermod -aG input $USER
==> Depois, REINICIE o computador (fechar e abrir o app não é suficiente).
==> As macros são salvas em ~/.config/mouse-remapper/config.json e aplicadas
==> pelo serviço de usuário "mouse-remapper.service" (ativado ao clicar em Salvar).

MSG
}

post_upgrade() {
    _reload_uinput
}

pre_remove() {
    echo "==> To disable the service for your user / Para desativar o serviço do seu usuário:"
    echo "==>     systemctl --user disable --now mouse-remapper.service"
}
